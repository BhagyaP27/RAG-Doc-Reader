# --LLM Provider ---
# Pick one: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Ollama — local, free, no API key needed (default)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3
EMBED_MODEL=nomic-embed-text

# OpenAI — uncomment these and set LLM_PROVIDER=openai to use GPT
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# Anthropic — uncomment these and set LLM_PROVIDER=anthropic to use Claude
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# --- Storage --- 
VECTOR_DB_PATH=./vector_store